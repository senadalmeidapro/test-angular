{
  "name": "angular-lab",
  "version": "1.0.0",
  "description": "Laboratoire Angular 22 orienté architecture, Signals, Reactive Forms et HTTP",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "start:api": "tsx watch server/index.ts",
    "dev": "concurrently --kill-others --names API,WEB --prefix-colors magenta,cyan \"npm:start:api\" \"npm:start\"",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "typecheck": "ng build --configuration development",
    "api:check": "tsc --project tsconfig.server.json --noEmit",
    "api:test": "tsx --test server/index.spec.ts",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "private": true,
  "packageManager": "npm@11.13.0",
  "dependencies": {
    "@angular/cdk": "^22.2.0",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/material": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "concurrently": "^10.0.5",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
